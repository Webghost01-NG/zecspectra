# Zcash Node RPC endpoints
# Mainnet (default: http://127.0.0.1:8232 for local Zebra/zcashd)
ZCASH_MAINNET_RPC=http://127.0.0.1:8232

# Testnet (default: http://127.0.0.1:18232)
ZCASH_TESTNET_RPC=http://127.0.0.1:18232

# Optional RPC authentication (if your node requires basic auth)
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
